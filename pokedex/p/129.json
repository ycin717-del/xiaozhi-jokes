{"全國圖鑑編號":129,"名字":"鯉魚王","英文名":"Magikarp","分類":"魚寶可夢","屬性":["水"],"第幾世代登場":1,"身高":"0.9 公尺","體重":"10 公斤","特性":["悠游自如"],"隱藏特性":["膽怯"],"種族值":{"HP":20,"攻擊":10,"防禦":55,"特攻":15,"特防":20,"速度":80,"總和":200},"被攻擊時":{"2倍傷害（弱點）":["草","電"],"0.5倍傷害（抵抗）":["鋼","火","水","冰"]},"進化":"鯉魚王 →(等級20) 暴鯉龍","圖鑑說明":"又弱又可憐的寶可夢。在水流比較快的地方，只能任憑自己被水沖走。","升級學會的招式":["Lv1 躍起","Lv15 撞擊","Lv25 抓狂"]}